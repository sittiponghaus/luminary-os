{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "#app/*": ["./app/*"],
      "#server/*": ["./server/*"],
      "#shared/*": ["./shared/*"],
      "#type/*": ["./type/*"],
      "@/*": ["./app/src/*"]
    }
  },
  "include": ["app/**/*", "server/**/*", "shared/**/*", "type/**/*"]
}
