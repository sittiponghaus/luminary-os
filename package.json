{
  "name": "luminary-os",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts --host 0.0.0.0 --port 5173 --strictPort",
    "dev:app": "vite --config app/vite.config.ts --host 0.0.0.0 --port 5173 --strictPort",
    "dev:server": "bun run --watch server/main.ts",
    "start:server": "bun run server/main.ts",
    "preview": "vite preview --config app/vite.config.ts --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build --config app/vite.config.ts",
    "proxy": "docker compose up caddy",
    "proxy:validate": "docker run --rm -v \"$PWD/deploy/Caddyfile:/etc/caddy/Caddyfile:ro\" caddy:2-alpine caddy validate --config /etc/caddy/Caddyfile",
    "typecheck": "tsc -p app/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run --config app/vitest.config.ts && vitest run --config server/vitest.config.ts",
    "test:app": "vitest run --config app/vitest.config.ts",
    "test:server": "vitest run --config server/vitest.config.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "imports": {
    "#app/*": "./app/*",
    "#server/*": "./server/*",
    "#shared/*": "./shared/*",
    "#type/*": "./type/*"
  },
  "dependencies": {
    "@effect/ai": "^0.37.0",
    "@effect/opentelemetry": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@effect/platform-bun": "4.0.0",
    "@foldkit/ui": "0.169.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0",
    "foldkit": "0.169.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "0.50.0",
    "@foldkit/devtools": "0.169.0",
    "@foldkit/devtools-mcp": "0.25.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@foldkit/vite-plugin": "0.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^3.2.0"
  }
}
